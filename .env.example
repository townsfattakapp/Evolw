# Public frontend (optional — same-origin /api is used by default)
# VITE_API_BASE_URL=

# Analytics (optional — client-side, only loaded in production when set)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_GTM_ID=GTM-XXXXXXX

# Neon Postgres connection string (Vercel / production)
DATABASE_URL=

# Admin authentication (server-only — never prefix with VITE_)
# Required on Vercel for /admin login to work
ADMIN_EMAIL=admin@evolw.in
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=

# Vercel Blob storage for resumes (server-only)
BLOB_READ_WRITE_TOKEN=

# Optional CORS origin (defaults to *)
# CORS_ORIGIN=https://www.evolw.in

# Community / Discourse Integration
# COMMUNITY_BASE_URL=https://community.evolw.in
# DISCOURSE_BASE_URL=https://community.evolw.in
# DISCOURSE_API_KEY=
# DISCOURSE_API_USERNAME=system
# VITE_COMMUNITY_BASE_URL=https://community.evolw.in

# Local Vite → API proxy (optional). Default in vite.config is https://www.evolw.in
# VITE_API_PROXY=http://127.0.0.1:3000

# GitHub Integration
# GITHUB_ORG=townsfattakapp
# GITHUB_TOKEN=
